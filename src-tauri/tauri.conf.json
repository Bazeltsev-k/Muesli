{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muesli",
  "version": "0.2.0",
  "identifier": "com.bazeltsev.muesli",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muesli",
        "width": 1240,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/muesli-recorder"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "demo/*": "demo/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMDhCOTI0QkY4OTNFQTgKUldTb1BvbS9KTGtJYllBdU5wczFYSmE5RFJwMHJjOFRaN2Z0Z3NEU3hjSUJONzlDSG5IdHIxSWoK",
      "endpoints": [
        "https://github.com/Bazeltsev-k/Muesli/releases/latest/download/latest.json"
      ]
    }
  }
}
